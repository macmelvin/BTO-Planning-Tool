rules_version = '2';

// BTO Planning Tool — Firestore Security Rules
// Sprint 0 baseline. Default-deny everything not explicitly matched below.

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------
    // USER-OWNED DATA
    // Covers anonymous-auth users (pre-signup) and linked accounts —
    // request.auth.uid is stable across the anonymous → linked upgrade,
    // so no data migration is needed when a user links a real account.
    // ---------------------------------------------------------------
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      match /eligibilityAnswers/{docId} {
        allow read, write: if isOwner(userId);
      }

      match /applications/{applicationId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && request.resource.data.keys().hasAll(['projectId', 'flatType'])
          && request.resource.data.projectId is string
          && request.resource.data.flatType is string;
        allow delete: if isOwner(userId);
      }

      match /notificationTokens/{tokenId} {
        allow write, delete: if isOwner(userId);
        allow read: if false;
      }
    }

    // ---------------------------------------------------------------
    // PUBLIC REFERENCE DATA
    // ---------------------------------------------------------------
    match /schemeDefinitions/{schemeId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /dropoutBenchmarks/{benchmarkId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /exerciseSummaries/{exercise} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /projects/{projectId} {
      allow read: if request.auth != null;
      allow write: if false;

      match /flatTypeOfferings/{flatType} {
        allow read: if request.auth != null;
        allow write: if false;

        match /schemeQuotaPools/{scheme} {
          allow read: if request.auth != null;
          allow write: if false;
        }
      }
    }

    // Sprint 6: launch windows are the one collection with client-side
    // writes enabled — gated to a single admin identity by email, checked
    // server-side. This is real enforcement: even if someone bypassed the
    // admin UI entirely and hit Firestore directly, this rule still holds.
    match /launchWindows/{quarter} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // ---------------------------------------------------------------
    // Everything else: denied by default.
    // ---------------------------------------------------------------

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function isAdmin() {
      // Hardcoded to one email rather than a role/claims system — deliberate
      // simplicity for a solo-admin app. If this ever needs multiple admins,
      // migrate to Firebase custom claims instead of a growing email list here.
      return request.auth != null
        && request.auth.token.email == 'macmelvin.tan@gmail.com';
    }
  }
}
