rules_version = '2';

// BTO Planning Tool — Firestore Security Rules
// Sprint 0 baseline. Default-deny everything not explicitly matched below.

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------
    // USER-OWNED DATA
    // ---------------------------------------------------------------
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      match /eligibilityAnswers/{docId} {
        allow read, write: if isOwner(userId);
      }

      match /applications/{applicationId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && request.resource.data.keys().hasAll(['projectId', 'flatType'])
          && request.resource.data.projectId is string
          && request.resource.data.flatType is string;
        allow delete: if isOwner(userId);
      }

      match /notificationTokens/{tokenId} {
        allow write, delete: if isOwner(userId);
        allow read: if false;
      }
    }

    // ---------------------------------------------------------------
    // PUBLIC REFERENCE DATA
    // schemeDefinitions/dropoutBenchmarks stay write:false — those are
    // rules/config, edited far less often and via the seed script's
    // deliberate versioning discipline (see config/seed-config-data.json
    // comments). exerciseSummaries and projects/flatTypeOfferings are
    // the data admin needs to update every BTO cycle, so those now allow
    // admin writes the same way launchWindows does.
    // ---------------------------------------------------------------
    match /schemeDefinitions/{schemeId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /dropoutBenchmarks/{benchmarkId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /exerciseSummaries/{exercise} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    match /projects/{projectId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();

      match /flatTypeOfferings/{flatType} {
        allow read: if request.auth != null;
        allow write: if isAdmin();

        match /schemeQuotaPools/{scheme} {
          allow read: if request.auth != null;
          allow write: if isAdmin();
        }
      }
    }

    match /launchWindows/{quarter} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // ---------------------------------------------------------------
    // Everything else: denied by default.
    // ---------------------------------------------------------------

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'macmelvin.tan@gmail.com';
    }
  }
}
